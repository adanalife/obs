#!/usr/bin/env python3
# pylint: disable=invalid-name,duplicate-code
"""Screenshot every source in the live OBS scene and fail on the blank ones.

Release-acceptance guard for the overlays: a crashed or never-painted
browser_source still exists in the scene, so "the pod is up" says nothing about
whether anything rendered. A blank source screenshots as a fully transparent
PNG, which compresses to a couple hundred bytes — the 2026-06-21 right-rotator
outage was diagnosed by `right rotating` coming back at 218 bytes while
`left rotating` came back with real content.

Read-only: GetCurrentProgramScene, GetSceneItemList, GetSourceScreenshot. No
scene mutation, nothing written to OBS — safe against the live stream.

Usage: OBS_WEBSOCKET_HOST=localhost OBS_WEBSOCKET_PORT=4455 ./bin/obs-screenshot-check

  OBS_SCREENSHOT_MIN_BYTES  PNGs smaller than this fail (default 1000)
  SCREENSHOT_DIR            dump each PNG here for eyeballing (default: no files)
"""

import base64
import logging
import os
import sys

try:
    import obsws_python as obs
except ImportError:
    print(
        "obsws-python not found — run via: uv run --with obsws-python bin/obs-screenshot-check",
        file=sys.stderr,
    )
    sys.exit(1)

# A failed request logs its own traceback at ERROR before raising; we report
# per-source verdicts ourselves and don't want the stack dump in between.
logging.getLogger("obsws_python").disabled = True

host = os.environ.get("OBS_WEBSOCKET_HOST", "localhost")
port = int(os.environ.get("OBS_WEBSOCKET_PORT", "4455"))
password = os.environ.get("OBS_WEBSOCKET_PASSWD", "")
min_bytes = int(os.environ.get("OBS_SCREENSHOT_MIN_BYTES", "1000"))
dump_dir = os.environ.get("SCREENSHOT_DIR")


def source_names(client, scene):
    """Every source in `scene`, including the members of its groups.

    OBS doesn't allow groups inside groups, so one level down is the whole tree.
    """
    for item in client.get_scene_item_list(scene).scene_items:
        yield item["sourceName"]
        if item.get("isGroup"):
            group = client.get_group_scene_item_list(item["sourceName"]).scene_items
            for child in group:
                yield child["sourceName"]


def capture(client, name):
    """PNG bytes for one source, at the source's own resolution."""
    # Sent raw rather than via get_source_screenshot() so imageWidth/imageHeight
    # can be omitted — OBS then returns full resolution, which is what the
    # blank-PNG byte threshold below is calibrated against.
    reply = client.send(
        "GetSourceScreenshot", {"sourceName": name, "imageFormat": "png"}
    )
    return base64.b64decode(reply.image_data.split(",", 1)[1])


try:
    with obs.ReqClient(host=host, port=port, password=password, timeout=10) as client:
        scene = client.get_current_program_scene().current_program_scene_name
        print(f"Scene: {scene}")

        if dump_dir:
            os.makedirs(dump_dir, exist_ok=True)

        failed = []
        for name in source_names(client, scene):
            try:
                png = capture(client, name)
            except Exception as e:  # pylint: disable=broad-except
                print(f"FAIL  {name:<28} screenshot failed: {e}")
                failed.append(name)
                continue

            if dump_dir:
                safe = name.replace("/", "_")
                with open(os.path.join(dump_dir, f"{safe}.png"), "wb") as f:
                    f.write(png)

            # Byte size is the whole blank detector: a blank source is a uniform
            # transparent PNG and compresses to ~200 bytes, real content to tens
            # of KB, so the gap is orders of magnitude. A source that renders
            # large-but-wrong content passes — catching that needs pixel
            # inspection, not a size check.
            if len(png) < min_bytes:
                print(f"FAIL  {name:<28} {len(png)} bytes (blank — under {min_bytes})")
                failed.append(name)
            else:
                print(f"PASS  {name:<28} {len(png)} bytes")

        if failed:
            print(f"\n{len(failed)} blank/missing source(s): {', '.join(failed)}")
            sys.exit(1)
        print("\nAll sources rendered.")
except ConnectionRefusedError:
    print(
        f"Could not connect to OBS WebSocket at {host}:{port} — is OBS running?",
        file=sys.stderr,
    )
    sys.exit(1)
except Exception as e:  # pylint: disable=broad-except
    print(f"Error: {e}", file=sys.stderr)
    sys.exit(1)
