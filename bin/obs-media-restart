#!/usr/bin/env python3
# pylint: disable=invalid-name,duplicate-code
"""Restart all OBS media sources (ffmpeg_source) via obs-websocket.

Useful after the RTSP source restarts (a playout or MediaMTX bounce) to force
OBS to reconnect rather than waiting for its own retry timer.

Usage: OBS_WEBSOCKET_HOST=localhost OBS_WEBSOCKET_PORT=4455 ./bin/obs-media-restart
"""

import os
import sys

MEDIA_KINDS = {"ffmpeg_source"}


def media_sources(inputs):
    """The ffmpeg_source inputs among `inputs`.

    Only media sources have a restart action; asking a browser or text source
    to restart is an error, and asking the whole input list to would take the
    overlays down with the video.
    """
    return [i for i in inputs if i["inputKind"] in MEDIA_KINDS]


def restart_all(client):
    """Restart every media source, returning how many were restarted."""
    sources = media_sources(client.get_input_list().inputs)
    if not sources:
        print("No media sources found in OBS.")
        return 0
    for source in sources:
        name = source["inputName"]
        client.trigger_media_input_action(
            name, "OBS_WEBSOCKET_MEDIA_INPUT_ACTION_RESTART"
        )
        print(f"Restarted: {name}")
    print(f"Done — restarted {len(sources)} media source(s).")
    return len(sources)


def main() -> int:
    try:
        import obsws_python as obs  # pylint: disable=import-outside-toplevel
    except ImportError:
        print(
            "obsws-python not found — run via: uv run --with obsws-python bin/obs-media-restart",
            file=sys.stderr,
        )
        return 1

    host = os.environ.get("OBS_WEBSOCKET_HOST", "localhost")
    port = int(os.environ.get("OBS_WEBSOCKET_PORT", "4455"))
    password = os.environ.get("OBS_WEBSOCKET_PASSWD", "")

    try:
        with obs.ReqClient(
            host=host, port=port, password=password, timeout=10
        ) as client:
            restart_all(client)
    except ConnectionRefusedError:
        print(
            f"Could not connect to OBS WebSocket at {host}:{port} — is OBS running?",
            file=sys.stderr,
        )
        return 1
    except Exception as e:  # pylint: disable=broad-except
        print(f"Error: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
