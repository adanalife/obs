#!/usr/bin/env python3
# pylint: disable=invalid-name,duplicate-code
"""Hard-reload OBS browser sources whose page has died.

A browser source that renders nothing — a crashed CEF renderer, a page that
never loaded because onscreens-server wasn't up yet — shows as a blank frame,
and `refreshnocache` can't revive it: the render process is gone. Pointing the
source at about:blank and back respawns it. Each run screenshots every
browser source and does that swap for the blank ones only; a source with
content on it is left alone.

Blankness is judged from a small BMP screenshot because BMP is raw pixels the
stdlib can read — no image library in the venv. A source that is blank by
design (an overlay between shows) reads as dead too, and a fresh renderer
leaves it just as blank, so a source that stays blank after its reload is
left alone until it has shown content again, or RETRY_S has passed in case
that reload itself found the page unreachable.

With --all, every browser source is reloaded whatever it is showing, and
nothing is remembered: the by-hand run for a page that renders but is stale.

Usage: OBS_WEBSOCKET_HOST=localhost OBS_WEBSOCKET_PORT=4455 ./bin/obs-browser-refresh [--all]
"""

from __future__ import annotations

import base64
import json
import os
import sys
import time

# Screenshot size. Small keeps the round-trip cheap; any real content survives
# the downscale as at least one differing pixel.
SHOT_W, SHOT_H = 64, 36

# How long a source sits on about:blank before its url is restored — long
# enough for CEF to tear the old renderer down, short enough to read as a
# flicker on a source that had content (which this script never reloads).
RELOAD_GAP_S = 0.6

BLANK_URL = "about:blank"

# How long a source that is still blank after a reload waits for the next one.
RETRY_S = 3600

# When each still-blank source was last reloaded, kept between runs. It lives
# in the container's /tmp so a pod restart starts every source fresh.
STATE_PATH = "/tmp/obs-browser-refresh.json"


def is_blank(bmp: bytes) -> bool:
    """True when every pixel in a BMP is the same color.

    Reads the pixel-array offset and bits-per-pixel from the header and
    compares pixels as fixed-width byte groups, so it holds for the 24- and
    32-bit images Qt writes and is oblivious to row order and padding for
    the widths in use here.
    """
    if len(bmp) < 30 or bmp[:2] != b"BM":
        raise ValueError("not a BMP")
    offset = int.from_bytes(bmp[10:14], "little")
    bpp = int.from_bytes(bmp[28:30], "little")
    if bpp not in (24, 32):
        raise ValueError(f"unsupported bpp {bpp}")
    stride = bpp // 8
    pixels = bmp[offset:]
    first = pixels[:stride]
    return all(
        pixels[i : i + stride] == first
        for i in range(0, len(pixels) - stride + 1, stride)
    )


def decode_screenshot(data_uri: str) -> bytes:
    """Strip the data-URI prefix obs-websocket wraps the image in."""
    return base64.b64decode(data_uri.split(",", 1)[1])


def load_reloads(path=STATE_PATH) -> dict:
    """The saved reload times, or none when the file is missing or unreadable."""
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def refresh_blank(client, sleep=time.sleep, reloads=None, now=time.time, force=False):
    """Respawn the renderer of every blank browser source.

    Returns (checked, reloaded). A source with no url is file-backed and has
    nothing to reload this way; a source with content on it is left alone.
    `reloads` maps a source to when it was last reloaded and is updated in
    place: a source still blank since a reload under RETRY_S ago is skipped,
    and one showing content is forgotten, so its next blank frame reloads it.
    With `force`, every source is reloaded unseen and `reloads` is left alone.
    The swap restores the source's own url, and both writes merge into the
    existing settings (overlay) so its size, css and the rest survive.
    """
    sources = [
        i["inputName"]
        for i in client.get_input_list().inputs
        if i["inputKind"] == "browser_source"
    ]
    reloaded = 0
    reloads = {} if reloads is None else reloads
    for name in sources:
        url = client.get_input_settings(name).input_settings.get("url")
        if not url:
            continue
        if url == BLANK_URL:
            # A swap whose restore never landed (a dropped websocket, a
            # timeout) left the source here, and its own url is gone with it:
            # swapping again would only restore about:blank. Only a pod
            # restart, which re-renders the collection, brings it back.
            print(
                f"Browser source stranded on {BLANK_URL}, needs a restart: {name}",
                file=sys.stderr,
            )
            continue
        if not force:
            shot = client.get_source_screenshot(name, "bmp", SHOT_W, SHOT_H, -1)
            if not is_blank(decode_screenshot(shot.image_data)):
                reloads.pop(name, None)
                continue
            if name in reloads and now() - reloads[name] < RETRY_S:
                continue
            reloads[name] = now()
        client.set_input_settings(name, {"url": BLANK_URL}, True)
        try:
            sleep(RELOAD_GAP_S)
        finally:
            client.set_input_settings(name, {"url": url}, True)
        reloaded += 1
        print(f"Reloaded {'' if force else 'blank '}source: {name}")
    return len(sources), reloaded


def main() -> int:
    try:
        import obsws_python as obs  # pylint: disable=import-outside-toplevel
    except ImportError:
        print(
            "obsws-python not found — run via: uv run --with obsws-python bin/obs-browser-refresh",
            file=sys.stderr,
        )
        return 1

    host = os.environ.get("OBS_WEBSOCKET_HOST", "localhost")
    port = int(os.environ.get("OBS_WEBSOCKET_PORT", "4455"))
    password = os.environ.get("OBS_WEBSOCKET_PASSWD", "")

    try:
        with obs.ReqClient(
            host=host, port=port, password=password, timeout=10
        ) as client:
            force = "--all" in sys.argv[1:]
            reloads = {} if force else load_reloads()
            try:
                checked, reloaded = refresh_blank(client, reloads=reloads, force=force)
            finally:
                # Saved even when a later source's call failed, so the reloads
                # already made this run are not repeated on the next one.
                if not force:
                    with open(STATE_PATH, "w", encoding="utf-8") as f:
                        json.dump(reloads, f)
            if not checked:
                print("No browser sources found in OBS.")
                return 0
            print(f"Done — {checked} browser source(s) checked, {reloaded} reloaded.")
    except ConnectionRefusedError:
        print(
            f"Could not connect to OBS WebSocket at {host}:{port} — is OBS running?",
            file=sys.stderr,
        )
        return 1
    except Exception as e:  # pylint: disable=broad-except
        print(f"Error: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
